source "Kconfig.zephyr"
menuconfig LED_SUBSYSTEM
    bool "Led Subsystem"
    default y

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP_TIME_CHOICE
    prompt "LED blink sleep time"
    default BLINK_SLEEP_TIME_MS_1S
    
    config BLINK_SLEEP_TIME_MS_250MS
        bool "250ms (very fast)"

    config BLINK_SLEEP_TIME_MS_500MS
        bool "500ms (fast)"

    config BLINK_SLEEP_TIME_MS_1S
        bool "1s (medium)"
    
    config BLINK_SLEEP_TIME_MS_2S
        bool "2s (slow)"
endchoice

config LED_BLINK_SLEEP_TIME
    int
    default 250 if BLINK_SLEEP_TIME_MS_250MS
    default 500 if BLINK_SLEEP_TIME_MS_500MS
    default 1000 if BLINK_SLEEP_TIME_MS_1S
    default 2000 if BLINK_SLEEP_TIME_MS_2S

menuconfig LED_ADVANCED
    bool "Advanced LED settings"
    default n

if LED_ADVANCED

config LED_BRIGHTNESS
    int "LED brightness"
    range 0 100
    default 100

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    range 0 5000
    default 500

menu "Expert settings"
    visible if LED_ADVANCED

    config LED_DEBUGGING
        bool "Enable LED debugging"
        default n

    config LED_CUSTOM_PATTERN
        bool "Custom blink pattern"
        default n


endmenu

endif # LED_ADVANCED

endif # LED_SUBSYSTEM
